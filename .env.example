TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
NOTION_TOKEN=your_notion_integration_token_here

# Notion databases the bot pulls recipes from. The default is both
# Le Garage locations (Cairo + El Gouna). Comma-separated. To switch
# restaurants, set this to the database ID(s) of the target menu(s).
NOTION_DATABASE_IDS=2ad2c25e-cb5d-8134-b661-e0323e39fb72,2ad2c25e-cb5d-8149-8303-f983d1aebced

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone (not recommended).
ALLOWED_USER_IDS=123456789,987654321
