TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
NOTION_TOKEN=your_notion_integration_token_here

# Le Garage restaurant databases. El Gouna is the canonical / primary
# source — recipes only fall back to Cairo when the slug isn't in El
# Gouna. Detect IDs with `node scripts/find-restaurants.js`.
NOTION_PARENT_EL_GOUNA=2ad2c25e-cb5d-8149-8303-f983d1aebced
NOTION_PARENT_CAIRO=2ad2c25e-cb5d-8134-b661-e0323e39fb72

# Optional alias — explicit override for the legacy comma-list form.
# If unset, the two NOTION_PARENT_* IDs above are used in order.
# NOTION_DATABASE_IDS=

# DEAD — the staff whitelist lives in allowed-users.json and is managed from
# Telegram (/adduser, /deluser, /users). Anything left here is IGNORED, not
# imported: the only way onto the roster is the admin adding you by hand.
ALLOWED_USER_IDS=

# Admin user: receives cache-mismatch alerts, runs /verify, and manages the
# staff whitelist. Defaults to the owner's id baked into bot.js, so the bot
# ships closed — set this only to hand the bot to a different admin.
# Get an id with /whoami.
ADMIN_USER_ID=

# Telegram handle shown to blocked users ("send this ID to @…"). Defaults to
# the owner's handle in bot.js. No leading @.
ADMIN_USERNAME=
