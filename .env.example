TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
NOTION_TOKEN=your_notion_integration_token_here

# Le Garage restaurant databases. El Gouna is the canonical / primary
# source — recipes only fall back to Cairo when the slug isn't in El
# Gouna. Detect IDs with `node scripts/find-restaurants.js`.
NOTION_PARENT_EL_GOUNA=2ad2c25e-cb5d-8149-8303-f983d1aebced
NOTION_PARENT_CAIRO=2ad2c25e-cb5d-8134-b661-e0323e39fb72

# Optional alias — explicit override for the legacy comma-list form.
# If unset, the two NOTION_PARENT_* IDs above are used in order.
# NOTION_DATABASE_IDS=

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# Admin user that receives cache-mismatch alerts and can run /verify
# and /verify --all. Single Telegram user id.
ADMIN_USER_ID=
