TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
NOTION_TOKEN=your_notion_integration_token_here

# Notion parent page that scopes recipe lookup to a single restaurant.
# The default is Le Garage Menu Cairo. Change this to switch the bot to
# another restaurant whose recipes are already shared with the same
# Notion integration.
NOTION_PARENT_ID=24e30eca-90bc-80de-8c59-e3c7db23fb60

# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone (not recommended).
ALLOWED_USER_IDS=123456789,987654321
