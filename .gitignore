# Environment
.env
.env.boho
.env.le_garage

# Cache (generated by cache-builder.js)
recipes-cache.json
recipes-cache.json.tmp
recipes-cache.backup.*.json

# User preferences (restaurant choice per Telegram user)
user-preferences.json
user-preferences.json.tmp

# Staff whitelist (managed from Telegram via /adduser · /deluser).
# Must stay out of git: `git pull` on deploy would otherwise overwrite the
# live roster, silently restoring access to people who were revoked.
allowed-users.json
allowed-users.json.tmp

# Dependencies
node_modules/

# Logs
*.log
cache.log

# PM2
# ecosystem.config.js is committed — it only references .env / .env.boho
# (those are gitignored) and carries no secrets itself.
.pm2/

# Editor / agent local settings
.claude/
.vscode/
.idea/

# Notion sync watermark (runtime state)
.notion-sync-state.json
